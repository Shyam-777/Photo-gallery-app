{
  "expo": {
    "name": "Photo Gallery",
    "slug": "photo-gallery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": { "image": "./assets/splash-icon.png", "resizeMode": "contain", "backgroundColor": "#4F46E5" },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shyam.photogallery"
    },
    "android": {
      "package": "com.shyam.photogallery",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Photo Gallery to access your photos.",
          "savePhotosPermission": "Allow Photo Gallery to save images to your gallery."
        }
      ]
    ],
    "web": { "favicon": "./assets/favicon.png" }
  }
}
